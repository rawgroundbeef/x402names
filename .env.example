# =============================================================================
# x402names Environment Configuration
# =============================================================================
# Copy to .env and fill in values. All variables have sensible defaults for
# local development with the mock registrar.

# --- Server ---
NODE_ENV=development          # development | test | production
PORT=3000                     # API server port
REDIRECT_PORT=3001            # Domain redirect server port
REDIRECT_SERVER_IP=127.0.0.1  # IP the redirect server is reachable at (used for DNS A records)
BEHIND_PROXY=false            # Set true if behind a reverse proxy (rate limiter uses X-Forwarded-For)
LOG_LEVEL=info                # debug | info | warn | error

# --- Database ---
DATABASE_URL=./data/app.db    # SQLite database path

# --- x402 Payment ---
X402_RECEIVING_ADDRESS=        # Your wallet address to receive USDC payments
X402_FACILITATOR_URL=https://x402.org/facilitator  # x402 facilitator endpoint
X402_NETWORK=eip155:84532      # EVM network (Base Sepolia by default)

# --- Namecheap Registrar (optional) ---
# Leave NAMECHEAP_API_USER empty to use MockRegistrar for development.
# Set all four to enable real domain registration via Namecheap.
NAMECHEAP_API_USER=            # Namecheap API username
NAMECHEAP_API_KEY=             # Namecheap API key (from Profile > Tools > API Access)
NAMECHEAP_CLIENT_IP=127.0.0.1 # Whitelisted IP for Namecheap API
NAMECHEAP_SANDBOX=true         # true = sandbox API, false = production API

# --- Pricing ---
DOMAIN_MARKUP_PERCENT=20       # Markup percentage applied to base registrar prices

# --- Registrar Contact Info (used for WHOIS on domain registrations) ---
REGISTRAR_CONTACT_FIRST_NAME=Domain
REGISTRAR_CONTACT_LAST_NAME=Admin
REGISTRAR_CONTACT_ADDRESS=123 Service St
REGISTRAR_CONTACT_CITY=San Francisco
REGISTRAR_CONTACT_STATE=CA
REGISTRAR_CONTACT_POSTAL=94105
REGISTRAR_CONTACT_COUNTRY=US
REGISTRAR_CONTACT_PHONE=+1.5555555555
REGISTRAR_CONTACT_EMAIL=domains@x402.org
